# Variables del frontend (Vite). Se leen al compilar (npm run build): si cambian, hay que volver a construir.
# Copie este archivo a .env.local para probar valores distintos en su equipo (.env.local no se sube a git).
# Sin ninguna variable, la app usa el gateway local (http://localhost:8000) a través del proxy de Vite.

# URL base del core. {region} se reemplaza por la región (co, br, us...).
#   Local (gateway, valor por defecto): /api/{region}
#   Render (sin gateway, sin el prefijo /api/co): https://<core-co>.onrender.com
VITE_API_BASE_URL=https://example-core-co.onrender.com

# Regiones que se muestran en el selector de país, separadas por coma.
#   Local (valor por defecto): co,br,us,fr,jp,de
#   Render: co
VITE_REGIONS=co

# Servicio de notificaciones (bandeja y avisos).
#   Local (valor por defecto): /subsystems/notifications
VITE_NOTIFICATIONS_URL=https://example-notifications.onrender.com

# WebSocket (STOMP) de notificaciones. Si se omite, se arma con VITE_NOTIFICATIONS_URL + /ws (ws:// o wss://).
#   Local (valor por defecto): ws://<host de la página>/subsystems/notifications/ws
VITE_WS_URL=wss://example-notifications.onrender.com/ws

# Subsistemas que siguen detrás del gateway (dispatch y billing; en Render no están desplegados).
#   Local (valor por defecto): /subsystems
# VITE_SUBSYSTEMS_URL=/subsystems

# Enlace a Grafana en la consola del administrador.
#   Local (valor por defecto): http://localhost:3000
# VITE_GRAFANA_URL=http://localhost:3000
